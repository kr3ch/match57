# Signing secret for session cookies. Required in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace-me-with-a-long-random-string

# SQLite database path (relative to repo root)
DATABASE_URL=sqlite+aiosqlite:///data/match57.db

# First user with this email is auto-flagged is_admin=True on register.
ADMIN_EMAILS=

# Same UX rate limit as v1 bot
RATE_LIMIT_SECONDS=0.7

# Frontend origin — used as the default CORS origin, verification link host,
# and to derive sane defaults for cookie SameSite/Secure. In production set
# this to the Vercel URL, e.g. https://match57.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Extra CORS configuration. CORS_ORIGINS overrides the FRONTEND_ORIGIN default;
# CORS_ORIGIN_REGEX additionally allows dynamic origins like Vercel previews.
#   CORS_ORIGINS=https://match57.vercel.app,http://localhost:3000
#   CORS_ORIGIN_REGEX=^https://match57-.*\.vercel\.app$
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Cookie security. Defaults are auto-derived from FRONTEND_ORIGIN:
#   - https://... non-localhost  → SameSite=None, Secure=1  (cross-site, prod)
#   - http://localhost           → SameSite=Lax,  Secure=0  (dev)
# Override only if you need something custom.
COOKIE_SAMESITE=
COOKIE_SECURE=

# Cookie name and TTL (days)
SESSION_COOKIE_NAME=match57_session
SESSION_TTL_DAYS=30

# Email (optional, prod). When unset — verification links are printed to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=match57 <noreply@match57.local>
SMTP_USE_TLS=1
