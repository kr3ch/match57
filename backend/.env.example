# Same Telegram bot token used by bot.py
BOT_TOKEN=

# Path to the JSON database -- MUST be the same path used by bot.py so the web
# and the bot read/write the same data.
DB_FILE=/data/users_db.json

# Comma-separated Telegram user IDs that may access /api/admin/*
ADMIN_IDS=752355263

# Telegram chat used as media bucket when the website uploads new photos /
# videos. Defaults to ADMIN_IDS[0].
STORAGE_CHAT_ID=

# Same UX rate limit as bot.py
RATE_LIMIT_SECONDS=0.7

# Frontend origin -- used for CORS, secure cookies and referral links.
FRONTEND_ORIGIN=http://localhost:3000

# Random secret used to sign session cookies. Change in production.
SESSION_SECRET=replace-me-with-a-long-random-string

# Bot username (e.g. match57bot). If empty the backend will fetch it via
# bot.get_me() at runtime.
BOT_USERNAME=
