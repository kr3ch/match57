# Backend origin used by the API client (REST), the WebSocket connection and
# the media URL helper. Required in production when frontend and backend live
# on different hosts (e.g. Vercel + Render).
#   dev:  NEXT_PUBLIC_API_URL=http://localhost:8000
#   prod: NEXT_PUBLIC_API_URL=https://match57.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram bot username (without leading @). Used by the Telegram Login Widget
# script to know which bot to authenticate against.
NEXT_PUBLIC_BOT_USERNAME=
