# ── DEV (next dev) ──────────────────────────────────────────────────────────
# Backend origin used by the rewrite rule. Leave NEXT_PUBLIC_API_BASE empty in
# dev so the API client uses /api/* (same origin) and the rewrite proxies to
# NEXT_PUBLIC_API_URL on :8000. In production (static export to GitHub Pages)
# you instead set NEXT_PUBLIC_API_BASE to the absolute backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Leave empty for dev. In production, set to the full backend URL,
# e.g. https://match57-api.fly.dev. Used by api client + WebSocket + media.
NEXT_PUBLIC_API_BASE=

# ── PROD (next build with STATIC_EXPORT=1) ──────────────────────────────────
# These are read by next.config.js when STATIC_EXPORT=1 to produce a static
# export under ./out, ready for GitHub Pages.
#
#   STATIC_EXPORT=1
#   NEXT_PUBLIC_BASE_PATH=/match57
#   NEXT_PUBLIC_API_BASE=https://match57-api.fly.dev
